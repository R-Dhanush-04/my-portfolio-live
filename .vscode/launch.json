{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Vite App (localhost:3000)",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Standalone HTML/CSS/JS (Live Server)",
      "url": "http://127.0.0.1:5500/standalone/index.html",
      "webRoot": "${workspaceFolder}/standalone"
    }
  ]
}
